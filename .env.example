# Main Supabase instance (database, auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Database connection
DATABASE_URL=postgres://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Storage instance (commercial Supabase for images)
# These are server-side only — never expose to the browser
STORAGE_SUPABASE_URL=https://your-storage-project.supabase.co
STORAGE_SUPABASE_ANON_KEY=your-storage-anon-key

# Shared secret for Edge Function upload authentication
# Must match the UPLOAD_SECRET set on the storage Supabase instance
# Generate with: openssl rand -base64 32
UPLOAD_SECRET=your-upload-secret

