# Main Supabase instance (database, auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Database connection
DATABASE_URL=postgres://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Optional: production smoke test credentials for scripts/prod-upload-smoke.mjs
PROD_SMOKE_ADMIN_EMAIL=admin@example.com
PROD_SMOKE_ADMIN_PASSWORD=your-admin-password
